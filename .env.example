# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore, so your real settings stay off GitHub.

# Long random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=citypharma
DB_PASSWORD=change-me
DB_NAME=citypharma_db

# Set to 1 only on your own machine while developing
FLASK_DEBUG=0
